$ ETABS .E2K Text File Export
$ Project: Structural Sample Building
$ Units: KN-m-C

PROGRAM INFORMATION
  PROGRAM "ETABS" VERSION "20.3.0"

CONTROLS
  UNITS "KN" "m" "C"

STORIES
  STORY "Roof" HEIGHT 3.0 ELEV 15.0 MASTER "Yes"
  STORY "Level 5" HEIGHT 3.0 ELEV 12.0 MASTER "No" SIMILARTO "Roof"
  STORY "Level 4" HEIGHT 3.0 ELEV 9.0 MASTER "No" SIMILARTO "Roof"
  STORY "Level 3" HEIGHT 3.0 ELEV 6.0 MASTER "No" SIMILARTO "Roof"
  STORY "Level 2" HEIGHT 3.0 ELEV 3.0 MASTER "No" SIMILARTO "Roof"
  STORY "Base" HEIGHT 0.0 ELEV 0.0 MASTER "No"

MATERIAL PROPERTIES
  MATERIAL "C30/37" TYPE "Concrete" E 32000000 FC 30000 POISSON 0.2
  MATERIAL "C40/50" TYPE "Concrete" E 35000000 FC 40000 POISSON 0.2

FRAME SECTIONS
  SECTION "C400x400" MATERIAL "C40/50" SHAPE "Rectangular" DEPTH 0.4 WIDTH 0.4
  SECTION "C500x500" MATERIAL "C40/50" SHAPE "Rectangular" DEPTH 0.5 WIDTH 0.5
  SECTION "B300x600" MATERIAL "C30/37" SHAPE "Rectangular" DEPTH 0.6 WIDTH 0.3

SHELL PROPERTIES
  SLAB "SLAB250" MATERIAL "C30/37" TYPE "Slab" THICKNESS 0.25
  SLAB "SLAB200" MATERIAL "C30/37" TYPE "Slab" THICKNESS 0.20
  WALL "WALL300" MATERIAL "C40/50" TYPE "Wall" THICKNESS 0.30

POINT COORDINATES
  $ Roof (Z = 15.0)
  POINT "N_R1" X 0.0 Y 0.0 Z 15.0 STORY "Roof"
  POINT "N_R2" X 10.0 Y 0.0 Z 15.0 STORY "Roof"
  POINT "N_R3" X 20.0 Y 0.0 Z 15.0 STORY "Roof"
  POINT "N_R4" X 0.0 Y 12.0 Z 15.0 STORY "Roof"
  POINT "N_R5" X 10.0 Y 12.0 Z 15.0 STORY "Roof"
  POINT "N_R6" X 20.0 Y 12.0 Z 15.0 STORY "Roof"

  $ Level 5 (Z = 12.0)
  POINT "N1" X 0.0 Y 0.0 Z 12.0 STORY "Level 5"
  POINT "N2" X 10.0 Y 0.0 Z 12.0 STORY "Level 5"
  POINT "N3" X 20.0 Y 0.0 Z 12.0 STORY "Level 5"
  POINT "N4" X 0.0 Y 12.0 Z 12.0 STORY "Level 5"
  POINT "N5" X 10.0 Y 12.0 Z 12.0 STORY "Level 5"
  POINT "N6" X 20.0 Y 12.0 Z 12.0 STORY "Level 5"

  $ Level 4 (Z = 9.0)
  POINT "N7" X 0.0 Y 0.0 Z 9.0 STORY "Level 4"
  POINT "N8" X 10.0 Y 0.0 Z 9.0 STORY "Level 4"
  POINT "N9" X 20.0 Y 0.0 Z 9.0 STORY "Level 4"
  POINT "N10" X 0.0 Y 12.0 Z 9.0 STORY "Level 4"
  POINT "N11" X 10.0 Y 12.0 Z 9.0 STORY "Level 4"
  POINT "N12" X 20.0 Y 12.0 Z 9.0 STORY "Level 4"

  $ Level 3 (Z = 6.0)
  POINT "N13" X 0.0 Y 0.0 Z 6.0 STORY "Level 3"
  POINT "N14" X 10.0 Y 0.0 Z 6.0 STORY "Level 3"
  POINT "N15" X 20.0 Y 0.0 Z 6.0 STORY "Level 3"
  POINT "N16" X 0.0 Y 12.0 Z 6.0 STORY "Level 3"
  POINT "N17" X 10.0 Y 12.0 Z 6.0 STORY "Level 3"
  POINT "N18" X 20.0 Y 12.0 Z 6.0 STORY "Level 3"

  $ Level 2 (Z = 3.0)
  POINT "N19" X 0.0 Y 0.0 Z 3.0 STORY "Level 2"
  POINT "N20" X 10.0 Y 0.0 Z 3.0 STORY "Level 2"
  POINT "N21" X 20.0 Y 0.0 Z 3.0 STORY "Level 2"
  POINT "N22" X 0.0 Y 12.0 Z 3.0 STORY "Level 2"
  POINT "N23" X 10.0 Y 12.0 Z 3.0 STORY "Level 2"
  POINT "N24" X 20.0 Y 12.0 Z 3.0 STORY "Level 2"

  $ Base (Z = 0.0)
  POINT "N25" X 0.0 Y 0.0 Z 0.0 STORY "Base"
  POINT "N26" X 10.0 Y 0.0 Z 0.0 STORY "Base"
  POINT "N27" X 20.0 Y 0.0 Z 0.0 STORY "Base"
  POINT "N28" X 0.0 Y 12.0 Z 0.0 STORY "Base"
  POINT "N29" X 10.0 Y 12.0 Z 0.0 STORY "Base"
  POINT "N30" X 20.0 Y 12.0 Z 0.0 STORY "Base"

LINE ASSIGNS
  $ Beams Level 5
  LINE "B1" TYPE "Beam" POINT1 "N1" POINT2 "N2" SECTION "B300x600" STORY "Level 5"
  LINE "B2" TYPE "Beam" POINT1 "N2" POINT2 "N3" SECTION "B300x600" STORY "Level 5"
  LINE "B3" TYPE "Beam" POINT1 "N4" POINT2 "N5" SECTION "B300x600" STORY "Level 5"
  LINE "B4" TYPE "Beam" POINT1 "N5" POINT2 "N6" SECTION "B300x600" STORY "Level 5"
  LINE "B5" TYPE "Beam" POINT1 "N1" POINT2 "N4" SECTION "B300x600" STORY "Level 5"
  LINE "B6" TYPE "Beam" POINT1 "N2" POINT2 "N5" SECTION "B300x600" STORY "Level 5"
  LINE "B7" TYPE "Beam" POINT1 "N3" POINT2 "N6" SECTION "B300x600" STORY "Level 5"

  $ Beams Level 4
  LINE "B4_1" TYPE "Beam" POINT1 "N7" POINT2 "N8" SECTION "B300x600" STORY "Level 4"
  LINE "B4_2" TYPE "Beam" POINT1 "N8" POINT2 "N9" SECTION "B300x600" STORY "Level 4"
  LINE "B4_3" TYPE "Beam" POINT1 "N10" POINT2 "N11" SECTION "B300x600" STORY "Level 4"
  LINE "B4_4" TYPE "Beam" POINT1 "N11" POINT2 "N12" SECTION "B300x600" STORY "Level 4"

  $ Columns Below Level 5 (between L4 & L5)
  LINE "C1" TYPE "Column" POINT1 "N7" POINT2 "N1" SECTION "C500x500" STORY "Level 5"
  LINE "C2" TYPE "Column" POINT1 "N8" POINT2 "N2" SECTION "C500x500" STORY "Level 5"
  LINE "C3" TYPE "Column" POINT1 "N9" POINT2 "N3" SECTION "C500x500" STORY "Level 5"
  LINE "C4" TYPE "Column" POINT1 "N10" POINT2 "N4" SECTION "C500x500" STORY "Level 5"
  LINE "C5" TYPE "Column" POINT1 "N11" POINT2 "N5" SECTION "C500x500" STORY "Level 5"
  LINE "C6" TYPE "Column" POINT1 "N12" POINT2 "N6" SECTION "C500x500" STORY "Level 5"

  $ Columns Above Level 5 (between L5 & Roof)
  LINE "CR1" TYPE "Column" POINT1 "N1" POINT2 "N_R1" SECTION "C400x400" STORY "Roof"
  LINE "CR2" TYPE "Column" POINT1 "N2" POINT2 "N_R2" SECTION "C400x400" STORY "Roof"
  LINE "CR3" TYPE "Column" POINT1 "N3" POINT2 "N_R3" SECTION "C400x400" STORY "Roof"
  LINE "CR4" TYPE "Column" POINT1 "N4" POINT2 "N_R4" SECTION "C400x400" STORY "Roof"
  LINE "CR5" TYPE "Column" POINT1 "N5" POINT2 "N_R5" SECTION "C400x400" STORY "Roof"
  LINE "CR6" TYPE "Column" POINT1 "N6" POINT2 "N_R6" SECTION "C400x400" STORY "Roof"

AREA ASSIGNS
  $ Slabs for all levels
  AREA "S_Roof" PROPERTY "SLAB200" STORY "Roof" POINTS "N_R1" "N_R3" "N_R6" "N_R4"
  AREA "S1" PROPERTY "SLAB250" STORY "Level 5" POINTS "N1" "N3" "N6" "N4"
  AREA "S_L4" PROPERTY "SLAB250" STORY "Level 4" POINTS "N7" "N9" "N12" "N10"
  AREA "S_L3" PROPERTY "SLAB250" STORY "Level 3" POINTS "N13" "N15" "N18" "N16"
  AREA "S_L2" PROPERTY "SLAB250" STORY "Level 2" POINTS "N19" "N21" "N24" "N22"

  $ Openings
  AREA "O1" PROPERTY "OPENING" STORY "Level 5" POINTS_COORD (4.0,4.0) (6.0,4.0) (6.0,6.0) (4.0,6.0)
  AREA "O2" PROPERTY "OPENING" STORY "Level 4" POINTS_COORD (4.0,4.0) (6.0,4.0) (6.0,6.0) (4.0,6.0)

  $ Shear Wall
  AREA "W1" PROPERTY "WALL300" STORY "Level 5" POINTS_COORD (10.0,0.0,9.0) (10.0,0.0,12.0) (10.0,4.0,12.0) (10.0,4.0,9.0)

LOAD PATTERNS
  PATTERN "DEAD" TYPE "Dead" SELFWEIGHT 1.0
  PATTERN "LIVE" TYPE "Live" SELFWEIGHT 0.0
  PATTERN "SDL" TYPE "Superdead" SELFWEIGHT 0.0

AREA LOADS
  AREALOAD AREA "S1" PATTERN "SDL" UNIFORM 1.5 DIRECTION "Gravity"
  AREALOAD AREA "S1" PATTERN "LIVE" UNIFORM 3.0 DIRECTION "Gravity"

END
