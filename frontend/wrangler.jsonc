{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etabs-ram-floor-exporter-production",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-25",

  // Static Assets (Vite Production Build)
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },

  // Staging Environment Configuration (stage branch)
  "env": {
    "staging": {
      "name": "etabs-ram-floor-exporter-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "single-page-application"
      }
    },
    // Production Environment Configuration (main branch)
    "production": {
      "name": "etabs-ram-floor-exporter-production",
      "vars": {
        "ENVIRONMENT": "production"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
