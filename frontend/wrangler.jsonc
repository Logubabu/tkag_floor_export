{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etabs-ram-floor-exporter-production",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "single-page-app",
    "not_found_handling": "single-page-app"
  },
  "containers": [
    {
      "name": "PYTHON_BACKEND",
      "class": "python-backend-container",
      "image": "dockerfile:../docker/Dockerfile.backend",
      "instance_type": "standard-1",
      "max_instances": 5
    }
  ],
  "env": {
    "staging": {
      "name": "etabs-ram-floor-exporter-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      }
    },
    "production": {
      "name": "etabs-ram-floor-exporter-production",
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
